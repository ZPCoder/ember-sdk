{
  "name": "@zpcoder/ember-sdk",
  "version": "0.1.0",
  "description": "Authoritative Ember Protocol rules, deterministic AI, and platform adapters.",
  "license": "UNLICENSED",
  "type": "module",
  "private": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./game": {
      "types": "./dist/src/game/index.d.ts",
      "import": "./dist/src/game/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZPCoder/ember-sdk.git"
  },
  "peerDependencies": {
    "@zpcoder/ember-config": "^0.1.0",
    "@zpcoder/ember-protocol": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@zpcoder/ember-config": { "optional": true },
    "@zpcoder/ember-protocol": { "optional": true }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.adapters.json",
    "test": "npm run typecheck && npm run build && node --test dist/test/*.test.js",
    "test:rules": "npm run build && node --test dist/test/game-engine.test.js",
    "pack:check": "npm pack --dry-run",
    "version-packages": "npx --yes @changesets/cli@2.29.8 version",
    "release": "npx --yes @changesets/cli@2.29.8 publish"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
