{
  "name": "@ember/sdk",
  "version": "1.0.0",
  "description": "Authoritative Ember Protocol rules, deterministic AI, and platform adapters.",
  "license": "UNLICENSED",
  "type": "module",
  "private": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./game": {
      "types": "./dist/src/game/index.d.ts",
      "import": "./dist/src/game/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "@ember/config": "^1.0.0",
    "@ember/protocol": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@ember/config": { "optional": true },
    "@ember/protocol": { "optional": true }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.adapters.json",
    "test": "npm run typecheck && npm run build && node --test dist/test/*.test.js",
    "test:rules": "npm run build && node --test dist/test/game-engine.test.js",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
